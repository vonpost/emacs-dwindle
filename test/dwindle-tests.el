;;; dwindle-tests.el --- Behavioral tests for dwindle -*- lexical-binding: t; -*-

(setq load-prefer-newer t)

(require 'ert)
(require 'cl-lib)
(require 'dwindle)
(require 'dwindle-resize)

(defun dwindle-test--native-nodes (window)
  "Return WINDOW and its native descendants, including internal nodes."
  (let ((nodes (list window))
        (child (window-child window)))
    (while child
      (setq nodes (nconc nodes (dwindle-test--native-nodes child))
            child (window-next-sibling child)))
    nodes))

(defmacro dwindle-test--with-layout (&rest body)
  "Run BODY in an isolated, generously sized native window layout."
  (declare (indent 0) (debug t))
  `(let ((previous-mode dwindle-mode)
         (split-window-preferred-function split-window-preferred-function)
         (window-min-width 6)
         (window-min-height 3)
         (window-combination-resize nil)
         (previous-parameters
          (mapcar (lambda (window)
                    (cons window (mapcar (lambda (entry) (cons (car entry) (cdr entry)))
                                         (window-parameters window))))
                  (dwindle-test--native-nodes (frame-root-window)))))
     (unwind-protect
         (save-window-excursion
           (unwind-protect
               (progn
                 (dwindle-mode -1)
                 (delete-other-windows)
                 (set-frame-size (selected-frame) 160 90)
                 (dwindle-mode 1)
                 ,@body)
             (dwindle-mode -1)))
       ;; Window configurations omit nonpersistent application parameters.
       ;; Restore these explicitly so hostile callbacks cannot poison the
       ;; original root and make an unrelated later test fail.
       (dolist (entry previous-parameters)
         (when (window-valid-p (car entry))
           (dolist (parameter (window-parameters (car entry)))
             (set-window-parameter (car entry) (car parameter) nil))
           (dolist (parameter (cdr entry))
             (set-window-parameter (car entry) (car parameter) (cdr parameter)))))
       (when previous-mode (dwindle-mode 1)))))

(defun dwindle-test--windows ()
  "Return ordinary windows in native tree order."
  (cl-remove-if-not #'dwindle--managed-window-p
                    (window-list nil 'nomini (frame-first-window))))

(defun dwindle-test--create (count)
  "Create COUNT managed leaves and return them in creation order."
  (let ((windows (list (selected-window))))
    (dotimes (_ (1- count))
      (let ((new (dwindle-split)))
        (should (window-live-p new))
        (should (eq new (selected-window)))
        (setq windows (append windows (list new)))))
    windows))

(defun dwindle-test--snapshot ()
  "Record live window identity, geometry, and displayed buffer."
  (mapcar (lambda (window)
            (list window (window-edges window) (window-buffer window)))
          (window-list nil 'nomini (frame-first-window))))

(defun dwindle-test--assert-native-root ()
  "Check root and master queries against the live native window tree."
  (should (window-valid-p (dwindle-root-window)))
  (should (eq (dwindle-root-window) (window-main-window)))
  (should (eq (dwindle-master-window) (car (dwindle-test--windows)))))

(ert-deftest dwindle-splits-the-focused-window-within-its-existing-area ()
  (dwindle-test--with-layout
    (let* ((a (selected-window))
           (b (dwindle-split))
           (b-before (window-edges b)))
      (should (eq dwindle-split-policy 'focused))
      (select-window a)
      (let ((c (dwindle-split)))
        (should (equal (dwindle-test--windows) (list a c b)))
        (should (equal (window-edges b) b-before))
        (should (= (nth 3 (window-edges a)) (nth 1 (window-edges c))))
        (select-window a)
        (let ((c-before (window-edges c))
              (d (dwindle-split)))
          (should (equal (dwindle-test--windows) (list a d c b)))
          (should (equal (window-edges b) b-before))
          (should (equal (window-edges c) c-before))
          (should (= (nth 2 (window-edges a)) (nth 0 (window-edges d))))
          (should (eq a (dwindle-master-window)))
          (dwindle-test--assert-native-root))))))

(ert-deftest dwindle-tail-policy-retains-trailing-alternating-splits ()
  (dwindle-test--with-layout
    (let* ((dwindle-split-policy 'tail)
           (a (selected-window))
           (b (dwindle-split)))
      ;; The compatibility policy deliberately ignores changes in focus.
      (select-window a)
      (let ((c (dwindle-split)))
        (select-window a)
        (let ((d (dwindle-split)))
          (should (equal (dwindle-test--windows) (list a b c d)))
          (should (= (nth 2 (window-edges a)) (nth 0 (window-edges b))))
          (should (= (nth 3 (window-edges b)) (nth 1 (window-edges c))))
          (should (= (nth 2 (window-edges c)) (nth 0 (window-edges d))))
          (should (= (nth 0 (window-edges b)) (nth 0 (window-edges c))))
          (should (= (nth 1 (window-edges c)) (nth 1 (window-edges d))))
          (should (eq a (dwindle-master-window)))
          (dwindle-test--assert-native-root))))))

(ert-deftest dwindle-split-displays-the-requested-buffer ()
  (dwindle-test--with-layout
    (let ((buffer (generate-new-buffer " *dwindle-test*")))
      (unwind-protect
          (should (eq (window-buffer (dwindle-split buffer)) buffer))
        (kill-buffer buffer)))))

(ert-deftest dwindle-can-start-by-splitting-below ()
  (dwindle-test--with-layout
    (let* ((dwindle-first-split 'below)
           (top (selected-window))
           (bottom-left (dwindle-split))
           (bottom-right (dwindle-split)))
      (should (= (nth 3 (window-edges top))
                 (nth 1 (window-edges bottom-left))))
      (should (= (nth 2 (window-edges bottom-left))
                 (nth 0 (window-edges bottom-right))))
      (should (eq (dwindle-master-window) top)))))

(ert-deftest dwindle-deleting-every-leaf-promotes-native-siblings ()
  (dotimes (victim-index 6)
    (dwindle-test--with-layout
      (let* ((windows (dwindle-test--create 6))
             (victim (nth victim-index windows))
             (survivors (delq victim (copy-sequence windows))))
        (select-window victim)
        (dwindle-delete-window)
        (should-not (window-live-p victim))
        (should (equal (dwindle-test--windows) survivors))
        (should (cl-every #'window-live-p survivors))
        (should (eq (dwindle-master-window) (car survivors)))
        (dwindle-test--assert-native-root)
        (let* ((source (selected-window))
               (new (dwindle-split)))
          (should (eq (window-parent new) (window-parent source)))
          (should (cl-every #'window-live-p survivors))
          (should (= (length (dwindle-test--windows)) 6)))
        (dwindle-test--assert-native-root)))))

(ert-deftest dwindle-native-deletion-and-configuration-restore-have-no-stale-master ()
  (dwindle-test--with-layout
    (let* ((windows (dwindle-test--create 4))
           (master (car windows))
           (configuration (current-window-configuration)))
      (delete-window master)
      (should (eq (dwindle-master-window) (cadr windows)))
      (dwindle-test--assert-native-root)
      (set-window-configuration configuration)
      (should (eq (dwindle-master-window) master))
      (should (window-live-p master))
      (dwindle-test--assert-native-root)
      (delete-other-windows (car (last windows)))
      (should (eq (dwindle-master-window) (selected-window)))
      (dwindle-test--assert-native-root)
      (should (window-live-p (dwindle-split)))
      (dwindle-test--assert-native-root))))

(ert-deftest dwindle-repeated-split-delete-stays-responsive ()
  ;; Makefile also puts the entire Emacs process under an external timeout:
  ;; Lisp timers cannot interrupt every kind of recursive window-hook failure.
  (dwindle-test--with-layout
    (dotimes (round 40)
      (dwindle-test--create 6)
      (dotimes (deletion 5)
        (let* ((windows (dwindle-test--windows))
               (index (mod (+ round (* deletion 3)) (length windows))))
          (select-window (nth index windows))
          ;; Exercise Emacs's own deletion path as well as our command.
          (if (zerop (% deletion 2))
              (delete-window)
            (dwindle-delete-window))
          (dwindle-test--assert-native-root)))
      (should (= (length (dwindle-test--windows)) 1)))))

(ert-deftest dwindle-unsplittable-window-leaves-no-partial-layout ()
  (dwindle-test--with-layout
    (let ((window-min-width 300)
          (window-min-height 150)
          (before (dwindle-test--snapshot))
          (selected (selected-window)))
      (should-not (condition-case nil
                      (dwindle-split)
                    (error nil)))
      (should (equal before (dwindle-test--snapshot)))
      (should (eq selected (selected-window)))
      (dwindle-test--assert-native-root))))

(ert-deftest dwindle-side-window-survives-splits-deletion-and-resizing ()
  (dwindle-test--with-layout
    (let* ((main (selected-window))
           (buffer (generate-new-buffer " *dwindle-side*"))
           (side (display-buffer-in-side-window
                  buffer '((side . bottom) (window-height . 6)))))
      (unwind-protect
          (let ((edges (window-edges side)))
            (select-window main)
            (let ((windows (dwindle-test--create 4)))
              (should-not (dwindle--managed-window-p side))
              (should (eq (dwindle-root-window) (window-main-window)))
              (select-window main)
              (dwindle-expand-right)
              (delete-window (cadr windows))
              (should (window-live-p (dwindle-split)))
              (should (window-live-p side))
              (should (eq (window-buffer side) buffer))
              (should (equal (window-edges side) edges))
              (dwindle-test--assert-native-root)))
        (kill-buffer buffer)))))

(ert-deftest dwindle-recognizes-windows-owned-by-other-features ()
  (dwindle-test--with-layout
    (let* ((ordinary (selected-window))
           (other (split-window ordinary nil 'right))
           (parent (window-parent other))
           (calls 0)
           (callback (lambda (&rest _) (cl-incf calls))))
      (should (dwindle--managed-window-p ordinary))
      (should-not (dwindle--managed-window-p (minibuffer-window)))
      (set-window-dedicated-p other t)
      (should-not (dwindle--managed-window-p other))
      (set-window-dedicated-p other nil)
      (dolist (parameter '(popup no-other-window dwindle-ignore no-delete-other-windows))
        (set-window-parameter other parameter t)
        (should-not (dwindle--managed-window-p other))
        (set-window-parameter other parameter nil))
      (dolist (parameter '(split-window delete-window delete-other-windows))
        (set-window-parameter other parameter callback)
        (should-not (dwindle--managed-window-p other))
        (set-window-parameter other parameter nil))
      (dolist (parameter '(popup no-other-window dwindle-ignore no-delete-other-windows
                           split-window delete-window delete-other-windows))
        (set-window-parameter parent parameter
                              (if (memq parameter '(split-window delete-window delete-other-windows))
                                  callback t))
        (should-not (dwindle--managed-window-p ordinary))
        (should-not (dwindle--managed-window-p other))
        (set-window-parameter parent parameter nil))
      (should (dwindle--managed-window-p ordinary))
      (should (dwindle--managed-window-p other))
      (should (= calls 0))
      (window-make-atom (window-parent other))
      (should-not (dwindle--managed-window-p ordinary))
      (should-not (dwindle--managed-window-p other)))))

(ert-deftest dwindle-mode-preserves-and-restores-the-preferred-splitter ()
  (let ((previous-mode dwindle-mode)
        (split-window-preferred-function #'ignore))
    (unwind-protect
        (progn
          (dwindle-mode -1)
          (setq split-window-preferred-function #'ignore)
          (let ((before (dwindle-test--snapshot)))
            (dwindle-mode 1)
            (should (equal before (dwindle-test--snapshot)))
            (should-not (eq split-window-preferred-function #'ignore))
            ;; Enabling twice must not overwrite the saved original.
            (dwindle-mode 1)
            (dwindle-mode -1)
            (should (eq split-window-preferred-function #'ignore))
            (should (equal before (dwindle-test--snapshot)))))
      (dwindle-mode -1)
      (when previous-mode (dwindle-mode 1)))))

(ert-deftest dwindle-disabling-preserves-a-later-third-party-splitter ()
  (dwindle-test--with-layout
    (setq-default split-window-preferred-function #'ignore)
    (dwindle-mode -1)
    (should (eq (default-value 'split-window-preferred-function) #'ignore))))

(ert-deftest dwindle-super-keybindings-use-hjkl-and-unshifted-rotate ()
  (dwindle-test--with-layout
    (dolist (entry '(("s-h" . windmove-left)
                     ("s-j" . windmove-down)
                     ("s-k" . windmove-up)
                     ("s-l" . windmove-right)
                     ("s-H" . dwindle-expand-left)
                     ("s-J" . dwindle-expand-down)
                     ("s-K" . dwindle-expand-up)
                     ("s-L" . dwindle-expand-right)
                     ("C-s-h" . dwindle-shrink-left)
                     ("C-s-j" . dwindle-shrink-down)
                     ("C-s-k" . dwindle-shrink-up)
                     ("C-s-l" . dwindle-shrink-right)
                     ("s-r" . dwindle-rotate)
                     ("s-E" . dwindle-new-buffer)
                     ("s-<return>" . dwindle-new-terminal)
                     ("s-RET" . dwindle-new-terminal)
                     ("s-S-<return>" . dwindle-new-persistent-terminal)
                     ("s-S-RET" . dwindle-new-persistent-terminal)))
      (should (eq (key-binding (kbd (car entry))) (cdr entry))))
    (should-not (eq (key-binding (kbd "s-R")) #'dwindle-rotate))))

(ert-deftest dwindle-new-buffer-creates-a-fresh-empty-buffer-on-each-call ()
  (dwindle-test--with-layout
    (let ((source (selected-window))
          created)
      (unwind-protect
          (let* ((first (dwindle-new-buffer))
                 (first-buffer (window-buffer first)))
            (push first-buffer created)
            (should (eq (selected-window) first))
            (should-not (eq first-buffer (window-buffer source)))
            (with-current-buffer first-buffer
              (should (= (buffer-size) 0))
              (should-not buffer-file-name)
              (insert "Keep the first scratch buffer.\n"))
            (select-window source)
            (let* ((second (dwindle-new-buffer))
                   (second-buffer (window-buffer second)))
              (push second-buffer created)
              (should (eq (selected-window) second))
              (should-not (eq first-buffer second-buffer))
              (with-current-buffer second-buffer
                (should (= (buffer-size) 0))
                (should-not buffer-file-name))
              (with-current-buffer first-buffer
                (should (equal (buffer-string) "Keep the first scratch buffer.\n")))
              (should (window-live-p source))
              (should (window-live-p first))
              (should (= (length (window-list nil 'nomini)) 3))))
        (dolist (buffer created)
          (when (buffer-live-p buffer)
            (with-current-buffer buffer (set-buffer-modified-p nil))
            (kill-buffer buffer)))))))

(ert-deftest dwindle-new-window-commands-inherit-the-focused-buffers-directory ()
  (dolist (command '(dwindle-new-buffer dwindle-new-terminal))
    (dwindle-test--with-layout
      (let* ((directory (file-name-as-directory (make-temp-file "dwindle-focused-dir-" t)))
             (source (generate-new-buffer " *dwindle-directory-source*"))
             (decoy (generate-new-buffer " *dwindle-directory-decoy*"))
             (native-require (symbol-function 'require))
             new-buffer factory-directory)
        (unwind-protect
            (progn
              (set-window-buffer (selected-window) source)
              (with-current-buffer source (setq default-directory directory))
              (with-current-buffer decoy (setq default-directory "/"))
              (cl-letf (((symbol-function 'require)
                         (lambda (feature &rest args)
                           (if (eq feature 'ghostel) 'ghostel
                             (apply native-require feature args))))
                        ((symbol-function 'ghostel-create)
                         (lambda (argument display &optional identity)
                           (should-not argument)
                           (should-not identity)
                           (setq factory-directory default-directory
                                 new-buffer (generate-new-buffer " *dwindle-directory-terminal*"))
                           (with-current-buffer new-buffer
                             (setq default-directory factory-directory))
                           (funcall (car display) new-buffer nil)
                           new-buffer)))
                (let ((new (with-current-buffer decoy (funcall command))))
                  (setq new-buffer (window-buffer new))
                  (should (eq (selected-window) new))
                  (should (equal (buffer-local-value 'default-directory new-buffer) directory))
                  (when (eq command 'dwindle-new-terminal)
                    (should (equal factory-directory directory))))))
          (dolist (buffer (list new-buffer source decoy))
            (when (buffer-live-p buffer) (kill-buffer buffer)))
          (delete-directory directory))))))

(ert-deftest dwindle-new-terminal-is-fresh-and-uses-only-its-dwindle-display-action ()
  (dwindle-test--with-layout
    (let* ((native-require (symbol-function 'require))
           (source (selected-window))
           (existing (generate-new-buffer " *dwindle-existing-terminal*"))
           (popup-action (list #'display-buffer-in-side-window '(side . bottom)))
           (display-buffer-alist (list (cons ".*" popup-action)))
           (display-buffer-overriding-action popup-action)
           created windows)
      (unwind-protect
          (cl-letf (((symbol-function 'require)
                     (lambda (feature &rest args)
                       (if (eq feature 'ghostel) 'ghostel
                         (apply native-require feature args))))
                    ((symbol-function 'ghostel-create)
                     (lambda (argument display &optional identity)
                       ;; The public nil argument means create a new terminal.
                       (should-not argument)
                       (should-not identity)
                       (should-not display-buffer-alist)
                       (should-not display-buffer-overriding-action)
                       (let ((buffer (generate-new-buffer " *dwindle-fresh-terminal*")))
                         (push buffer created)
                         (should (listp display))
                         (let ((new (funcall (car display) buffer nil)))
                           (should (window-live-p new))
                           (should (eq (window-buffer new) buffer))
                           (should (eq (selected-window) new)))
                         buffer))))
            (dotimes (_ 2)
              (select-window source)
              (push (dwindle-new-terminal) windows))
            (should (= (length created) 2))
            (should-not (eq (car created) (cadr created)))
            (should-not (memq existing created))
            (should (window-live-p source))
            (should (cl-every #'window-live-p windows))
            (should (= (length (window-list nil 'nomini)) 3))
            (should (cl-every (lambda (window) (not (window-parameter window 'window-side)))
                              windows))
            (should (eq display-buffer-overriding-action popup-action))
            (should (equal display-buffer-alist (list (cons ".*" popup-action)))))
        (dolist (buffer (cons existing created))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest dwindle-new-window-commands-clean-up-after-native-split-refusal ()
  (dolist (command '(dwindle-new-buffer dwindle-new-terminal))
    (dwindle-test--with-layout
      (let ((native-require (symbol-function 'require))
            (window-min-width 300)
            (window-min-height 150)
            (source (selected-window))
            (before (dwindle-test--snapshot))
            (buffers-before (buffer-list))
            terminal-buffer)
        (cl-letf (((symbol-function 'require)
                   (lambda (feature &rest args)
                     (if (eq feature 'ghostel) 'ghostel
                       (apply native-require feature args))))
                  ((symbol-function 'ghostel-create)
                   (lambda (_argument display &optional _identity)
                     (setq terminal-buffer (generate-new-buffer " *dwindle-refused-terminal*"))
                     (funcall (car display) terminal-buffer nil)
                     terminal-buffer)))
          (should-error (funcall command)))
        (should (eq (selected-window) source))
        (should (equal (dwindle-test--snapshot) before))
        (should-not (cl-set-difference (buffer-list) buffers-before))
        (when terminal-buffer (should-not (buffer-live-p terminal-buffer)))))))

(ert-deftest dwindle-new-terminal-launch-failure-cleans-up-without-prompting ()
  (dwindle-test--with-layout
    (let* ((native-require (symbol-function 'require))
           (previous (generate-new-buffer " *dwindle-previous-terminal*"))
           (previous-process (make-pipe-process :name "dwindle-previous-terminal"
                                               :buffer previous :noquery t))
           (source (selected-window))
           (before (dwindle-test--snapshot))
           failed-buffer failed-process cleanup-hook-ran)
      (unwind-protect
          (cl-letf (((symbol-function 'require)
                     (lambda (feature &rest args)
                       (if (eq feature 'ghostel) 'ghostel
                         (apply native-require feature args))))
                    ((symbol-function 'ghostel-create)
                     (lambda (_argument display &optional _identity)
                       (setq failed-buffer (generate-new-buffer " *dwindle-failed-terminal*"))
                       (funcall (car display) failed-buffer nil)
                       (setq failed-process
                             (make-pipe-process :name "dwindle-failed-terminal"
                                                :buffer failed-buffer :noquery nil))
                       (with-current-buffer failed-buffer
                         (add-hook 'kill-buffer-hook (lambda () (setq cleanup-hook-ran t)) nil t))
                       (error "Injected Ghostel launch failure")))
                    ((symbol-function 'yes-or-no-p)
                     (lambda (&rest _) (ert-fail "Terminal cleanup must not prompt")))
                    ((symbol-function 'y-or-n-p)
                     (lambda (&rest _) (ert-fail "Terminal cleanup must not prompt"))))
            (should (equal (should-error (dwindle-new-terminal))
                           '(error "Injected Ghostel launch failure")))
            (should (eq (selected-window) source))
            (should (equal (dwindle-test--snapshot) before))
            (should cleanup-hook-ran)
            (should-not (buffer-live-p failed-buffer))
            (should-not (process-live-p failed-process))
            (should (buffer-live-p previous))
            (should (process-live-p previous-process)))
        (dolist (buffer (list failed-buffer previous))
          (when (buffer-live-p buffer)
            (let ((kill-buffer-query-functions nil))
              (kill-buffer buffer))))))))

(ert-deftest dwindle-final-selection-hooks-cannot-reenter-window-creation ()
  (dolist (command '(dwindle-new-buffer dwindle-new-terminal dwindle-split))
    (dolist (focus '(leaf internal))
      (dwindle-test--with-layout
        (when (eq focus 'internal)
          (dwindle-test--create 3)
          (should-not (window-live-p (dwindle-focus-parent))))
        (let* ((native-require (symbol-function 'require))
               (original-windows (window-list nil 'nomini))
               (original-buffers (buffer-list))
               (target (when (eq command 'dwindle-split)
                         (generate-new-buffer " *dwindle-selection-target*")))
               (callbacks 0)
               guarded errors attempting)
          (unwind-protect
              (cl-letf (((symbol-function 'require)
                         (lambda (feature &rest args)
                           (if (eq feature 'ghostel) 'ghostel
                             (apply native-require feature args))))
                        ((symbol-function 'ghostel-create)
                         (lambda (_argument display &optional _identity)
                           (let ((buffer (generate-new-buffer " *dwindle-selection-terminal*")))
                             (funcall (car display) buffer nil)
                             buffer))))
                (let ((buffer-list-update-hook
                       (list
                        (lambda ()
                          (unless (memq (selected-window) original-windows)
                            (cl-incf callbacks)
                            (push dwindle--inhibit guarded)
                            ;; Cap recursion even when testing a broken guard,
                            ;; so this regression itself cannot loop forever.
                            (unless attempting
                              (setq attempting t)
                              (unwind-protect
                                  (condition-case error
                                      (dwindle-new-buffer)
                                    (user-error (push error errors)))
                                (setq attempting nil))))))))
                  (let ((new (if target (dwindle-split target) (funcall command))))
                    (should (window-live-p new))
                    (should (eq (selected-window) new))))
                (should (> callbacks 0))
                (should (cl-every #'identity guarded))
                (should (= callbacks (length errors)))
                (should (cl-every (lambda (error)
                                   (string-match-p "already in progress" (error-message-string error)))
                                 errors))
                (should (= (length (window-list nil 'nomini)) (1+ (length original-windows))))
                (should (= (length (cl-set-difference (buffer-list) original-buffers)) 1)))
            (dolist (buffer (cl-set-difference (buffer-list) original-buffers))
              (when (buffer-live-p buffer)
                (with-current-buffer buffer (set-buffer-modified-p nil))
                (kill-buffer buffer)))))))))

(ert-deftest dwindle-failed-terminal-cleanup-continues-after-a-throwing-kill-hook ()
  (dwindle-test--with-layout
    (let* ((native-require (symbol-function 'require))
           (source (selected-window))
           (source-buffer (generate-new-buffer " *dwindle-cleanup-editor*"))
           (source-kill-hook-ran nil)
           (source-kill-hook (list (lambda ()
                                     (setq source-kill-hook-ran t)
                                     (error "Editor cleanup hook must not run"))))
           before failed-buffer failed-process later-hook-ran)
      (unwind-protect
          (progn
            (set-window-buffer source source-buffer)
            (with-current-buffer source-buffer
              (insert "Keep the editor buffer intact.\n")
              (set-buffer-modified-p nil)
              (setq-local kill-buffer-hook source-kill-hook))
            (setq before (dwindle-test--snapshot))
            (cl-letf (((symbol-function 'require)
                     (lambda (feature &rest args)
                       (if (eq feature 'ghostel) 'ghostel
                         (apply native-require feature args))))
                    ((symbol-function 'ghostel-create)
                     (lambda (_argument display &optional _identity)
                       (setq failed-buffer (generate-new-buffer " *dwindle-throwing-cleanup*"))
                       (funcall (car display) failed-buffer nil)
                       (setq failed-process
                             (make-pipe-process :name "dwindle-throwing-cleanup"
                                                :buffer failed-buffer :noquery nil))
                       (with-current-buffer failed-buffer
                         (setq-local kill-buffer-hook
                                     (list (lambda () (error "Injected cleanup hook failure"))
                                           (lambda () (set-buffer source-buffer))
                                           (lambda ()
                                             ;; Cleanup code must see its own
                                             ;; buffer and locals even if an
                                             ;; earlier hook switched buffers.
                                             (should (eq (current-buffer) failed-buffer))
                                             (should (eq (get-buffer-process (current-buffer)) failed-process))
                                             (setq later-hook-ran t)
                                             (delete-process failed-process)))))
                       (error "Original terminal initialization failure"))))
            (should (equal (should-error (dwindle-new-terminal))
                           '(error "Original terminal initialization failure")))
            (should later-hook-ran)
            (should-not (buffer-live-p failed-buffer))
            (should-not (process-live-p failed-process))
            (should (eq (selected-window) source))
            (should (equal (dwindle-test--snapshot) before))
            (should-not source-kill-hook-ran)
            (should (buffer-live-p source-buffer))
            (should (eq (buffer-local-value 'kill-buffer-hook source-buffer) source-kill-hook))
            (with-current-buffer source-buffer
              (should (equal (buffer-string) "Keep the editor buffer intact.\n")))))
        (dolist (buffer (list failed-buffer source-buffer))
          (when (buffer-live-p buffer)
            (with-current-buffer buffer
              (let ((kill-buffer-hook nil)
                    (kill-buffer-query-functions nil))
                (kill-buffer buffer)))))))))

(ert-deftest dwindle-directional-resize-moves-the-requested-edge ()
  (dolist (direction '(left right up down))
    (dolist (operation '(expand shrink))
      (dwindle-test--with-layout
        (let* ((horizontal (memq direction '(left right)))
               (first (selected-window))
               (second (split-window first nil (if horizontal 'right 'below)))
               (selected (if (memq direction '(left up)) second first))
               (measure (if horizontal #'window-total-width #'window-total-height))
               (command (intern (format "dwindle-%s-%s" operation direction))))
          (select-window selected)
          (let ((before (funcall measure selected)))
            (should (numberp (funcall command)))
            (should (funcall (if (eq operation 'expand) #'> #'<)
                             (funcall measure selected) before))
            (should (= (length (dwindle-test--windows)) 2))))))))

(ert-deftest dwindle-expand-at-an-outer-edge-shrinks-from-the-opposite-edge ()
