(ert-deftest dwindle-buffer-local-hook-cannot-poison-rollback-or-delete-old-windows ()
  (dolist (poison '(atomic delete-override))
    (dwindle-test--with-layout
      (let* ((windows (dwindle-test--create 2))
             (source (selected-window))
             (root (dwindle-root-window))
             (root-parameters (copy-tree (cl-remove-if-not #'cdr (window-parameters root))))
             (before (dwindle-test--snapshot))
             (buffer (generate-new-buffer " *dwindle-poisoned-scroll*")))
        (unwind-protect
            (progn
              (set-window-parameter source 'dwindle-test-marker 'keep)
              (with-current-buffer buffer
                (setq-local
                 window-scroll-functions
                 (list (lambda (window _start)
                         (pcase poison
                           ('atomic (window-make-atom (window-parent window)))
                           ('delete-override
                            (set-window-parameter window 'delete-window #'ignore)))
                         (error "Injected buffer-local rollback poison")))))
              (should-error (dwindle-split buffer))
              (should (cl-every #'window-live-p windows))
              (should (eq (selected-window) source))
              (should (equal (dwindle-test--snapshot) before))
              (should (eq (dwindle-root-window) root))
              (should (equal (cl-remove-if-not #'cdr (window-parameters root))
                             root-parameters))
              (should (eq (window-parameter source 'dwindle-test-marker) 'keep))
              (dolist (window windows)
                (should-not (window-atom-root window))
                (should (dwindle--managed-window-p window)))
              ;; Failed hooks must not leave a guard or native tree poisoned.
              (should (window-live-p (dwindle-split))))
          (kill-buffer buffer))))))

