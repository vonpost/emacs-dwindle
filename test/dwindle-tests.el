(ert-deftest dwindle-automatic-display-with-internal-focus-keeps-existing-window-objects ()
  (dwindle-test--with-layout
    (let* ((windows (dwindle-test--create 3))
           (master (car windows))
           (focused (caddr windows))
           (focused-edges (window-edges focused nil nil t))
           (outside (mapcar (lambda (window)
                              (list window (window-buffer window)
                                    (window-edges window nil nil t)))
                            (butlast windows)))
           (root (dwindle-root-window)))
      (select-window focused)
      (let ((node (dwindle-focus-parent)))
        (should-not (window-live-p node))
        (let ((new (funcall split-window-preferred-function master)))
          ;; An automatic display action must split just the selected leaf;
          ;; reconstructing the internally focused region would retire old
          ;; window objects that the display action did not ask to replace.
          (should (window-live-p new))
          (should (cl-every #'window-live-p windows))
          (should (cl-every #'dwindle--owned-window-p windows))
          (should-not (dwindle--owned-window-p new))
          (should (eq (selected-window) focused))
          (should (eq (dwindle-root-window) root))
          (should (window-valid-p node))
          (should (equal (window-list nil 'nomini (frame-first-window))
                         (append windows (list new))))
          (should (eq (window-parent new) (window-parent focused)))
          (should (equal (window-edges (window-parent new) nil nil t) focused-edges))
          (dolist (snapshot outside)
            (should (eq (window-buffer (car snapshot)) (nth 1 snapshot)))
            (should (equal (window-edges (car snapshot) nil nil t)
                           (nth 2 snapshot)))))))))

