  ;; to ShrinkFrom in the opposite direction, reducing the focused pane.
  (dolist (direction '(left right up down))
    (dwindle-test--with-layout
      (let* ((horizontal (memq direction '(left right)))
             (first (selected-window))
             (second (split-window first nil (if horizontal 'right 'below)))
             (selected (if (memq direction '(left up)) first second))
             (measure (if horizontal #'window-total-width #'window-total-height))
             (command (intern (format "dwindle-expand-%s" direction))))
        (select-window selected)
        (let ((before (funcall measure selected)))
          (should (numberp (funcall command)))
          (should (< (funcall measure selected) before)))))))

