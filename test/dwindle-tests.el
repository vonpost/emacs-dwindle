                (should (equal (dwindle-test--snapshot) before)))))
        (kill-buffer buffer)))))

(ert-deftest dwindle-find-file-keeps-editor-ownership-and-alternating-splits ()
  (dwindle-test--with-layout
    (let* ((master (selected-window))
           (editor (dwindle-split))
           (master-edges (window-edges master))
           (file (make-temp-file "dwindle-navigation-" nil ".txt"
                                 "Ordinary file navigation stays in this editor pane.\n"))
           buffer)
      (unwind-protect
          (progn
            (find-file file)
            (setq buffer (find-buffer-visiting file))
            (should (eq (selected-window) editor))
            (should (eq (window-buffer editor) buffer))
            ;; Real find-file installs a native restoration record for this
            ;; existing pane; it must not look like an external popup.
            (should (window-parameter editor 'quit-restore))
            (dwindle--refresh)
            (should (dwindle--managed-window-p editor))
            (should (dwindle--owned-window-p editor))
            (let ((new (dwindle-split)))
              (should (dwindle--owned-window-p new))
              (should (eq (window-buffer new) buffer))
              (should (equal (window-edges master) master-edges))
              (should (= (nth 0 (window-edges editor)) (nth 0 (window-edges new))))
              (should (= (nth 2 (window-edges editor)) (nth 2 (window-edges new))))
              (should (= (nth 3 (window-edges editor)) (nth 1 (window-edges new))))))
        (when (buffer-live-p buffer) (kill-buffer buffer))
        (delete-file file)))))

(ert-deftest dwindle-background-display-reuse-revokes-editor-ownership ()
  (dwindle-test--with-layout
    (let* ((source (selected-window))
           (target (dwindle-split))
           (buffer (generate-new-buffer " *dwindle-background-reuse*")))
      (unwind-protect
          (progn
            (should (dwindle--owned-window-p target))
            (select-window source)
            ;; This is the native final step of an external display action
            ;; that chose an existing pane while another pane has focus.
            (should (eq (window--display-buffer buffer target 'reuse) target))
            (should (eq (selected-window) source))
            (should (eq (window-buffer target) buffer))
            (should (window-parameter target 'quit-restore))
            (dwindle--refresh)
            (should-not (dwindle--managed-window-p target))
            (should-not (dwindle--owned-window-p target))
            ;; Clearing native lifecycle bookkeeping later cannot silently
            ;; re-enroll a pane which an external display action took over.
            (set-window-parameter target 'quit-restore nil)
            (dwindle--refresh)
            (should (dwindle--managed-window-p target))
            (should-not (dwindle--owned-window-p target))
            (let ((before (dwindle-test--snapshot)))
              (should-not (dwindle-rotate))
              (should (equal (dwindle-test--snapshot) before))
              (should (window-live-p target))
              (should (eq (window-buffer target) buffer))))
        (kill-buffer buffer)))))

(ert-deftest dwindle-preferred-split-favors-focus-over-the-suggested-window ()
  (dwindle-test--with-layout
    (let* ((windows (dwindle-test--create 3))
           (master (car windows))
           (focused (cadr windows))
           (tail (caddr windows))
           (master-before (window-edges master))
           (tail-before (window-edges tail)))
      (select-window focused)
      (let ((new (funcall split-window-preferred-function master)))
        (should (window-live-p new))
        (should (eq focused (selected-window)))
        (should (eq (window-parent new) (window-parent focused)))
        (should (equal (window-edges master) master-before))
        (should (equal (window-edges tail) tail-before))))))

(ert-deftest dwindle-refuses-a-full-focused-pane-instead-of-splitting-elsewhere ()
  (dwindle-test--with-layout
    (let* ((windows (dwindle-test--create 3))
           (master (car windows))
           (focused (caddr windows))
           (window-min-width 50)
           (buffer (generate-new-buffer " *dwindle-full-focus*")))
      (unwind-protect
          (let ((before (dwindle-test--snapshot)))
            (select-window focused)
            (should-error (dwindle-split))
            (should-not (funcall split-window-preferred-function master))
            (should-not (display-buffer-pop-up-window buffer nil))
            (should (eq (selected-window) focused))
            (should (equal (dwindle-test--snapshot) before))
            ;; There is room elsewhere; choosing it must be explicit.
            (select-window master)
            (should (window-live-p (dwindle-split))))
        (kill-buffer buffer)))))

(ert-deftest dwindle-foreign-focus-refuses-explicit-and-automatic-insertion ()
  (dolist (kind '(popup no-other-window dedicated custom-split))
    (dwindle-test--with-layout
      (let* ((ordinary (selected-window))
             (foreign (split-window ordinary nil 'right))
             (buffer (generate-new-buffer " *dwindle-foreign-display*")))
        (unwind-protect
            (progn
              (pcase kind
                ('dedicated (set-window-dedicated-p foreign t))
                ('custom-split (set-window-parameter foreign 'split-window #'ignore))
                (_ (set-window-parameter foreign kind t)))
              (select-window foreign)
              (let ((before (dwindle-test--snapshot)))
                (should-error (dwindle-split) :type 'user-error)
                (should-not (funcall split-window-preferred-function ordinary))
                (should-not (display-buffer-pop-up-window buffer nil))
                (should (eq (selected-window) foreign))
                (should (equal (dwindle-test--snapshot) before))
                (select-window ordinary)
                (should-not (funcall split-window-preferred-function foreign))
                (should (equal (dwindle-test--snapshot) before))))
          (kill-buffer buffer))))))

(ert-deftest dwindle-nary-resize-changes-only-the-adjacent-pair ()
  (dolist (direction '(left right up down))
    (dolist (operation '(expand shrink))
      (dwindle-test--with-layout
        (let* ((window-combination-limit nil)
               (horizontal (memq direction '(left right)))
               (side (if horizontal 'right 'below))
               (size (if horizontal 40 20))
               (a (selected-window))
               (b (split-window a size side))
               (c (split-window b size side))
               (d (split-window c size side))
               (focused (if (memq direction '(left up)) c b))
               (measure (if horizontal #'window-total-width #'window-total-height))
               (a-before (window-edges a))
               (d-before (window-edges d))
               (before (funcall measure focused))
               (pair-size (+ (funcall measure b) (funcall measure c))))
          (should (eq (window-parent a) (window-parent d)))
          (select-window focused)
          (should (numberp (funcall (intern (format "dwindle-%s-%s" operation direction)))))
          (should (funcall (if (eq operation 'expand) #'> #'<)
                           (funcall measure focused) before))
          (should (= (+ (funcall measure b) (funcall measure c)) pair-size))
          (should (equal (window-edges a) a-before))
          (should (equal (window-edges d) d-before)))))))

(ert-deftest dwindle-nary-resize-preserves-unrelated-foreign-siblings ()
  (dwindle-test--with-layout
    (let* ((window-combination-limit nil)
           (a (selected-window))
           (b (split-window a 40 'right))
           (c (split-window b 40 'right))
           (d (split-window c 40 'right))
           (a-before (window-edges a))
           (d-before (window-edges d)))
      (set-window-dedicated-p a t)
      (set-window-parameter d 'popup t)
      (select-window b)
      (should (numberp (dwindle-expand-right)))
      (should (equal (window-edges a) a-before))
      (should (equal (window-edges d) d-before))
      (should (> (window-total-width b) 40))
      (should (< (window-total-width c) 40))
      (let ((before (dwindle-test--snapshot)))
        (should-not (dwindle-expand-left))
        (should-not (dwindle-shrink-left))
        (should (equal (dwindle-test--snapshot) before))))))

(ert-deftest dwindle-move-split-moves-the-divider-in-the-requested-direction ()
  (dolist (direction '(left right up down))
    (dolist (focus '(first second))
      (dwindle-test--with-layout
        (let* ((horizontal (memq direction '(left right)))
               (first (selected-window))
               (second (split-window first nil (if horizontal 'right 'below)))
               (edge (if horizontal 2 3))
               (before (nth edge (window-edges first)))
               (focused (if (eq focus 'first) first second)))
          (select-window focused)
          (should (numberp (funcall (intern (format "dwindle-move-split-%s" direction)))))
          (should (funcall (if (memq direction '(left up)) #'< #'>)
                           (nth edge (window-edges first)) before))
          (should (eq (selected-window) focused)))))))

(ert-deftest dwindle-move-split-prefers-a-farther-after-boundary-to-a-nearer-before-one ()
  (dwindle-test--with-layout
    (let* ((window-combination-limit t)
           (left (selected-window))
           (right (split-window left 80 'right))
           (focused (split-window left 40 'right))
           (right-before (window-edges right)))
      ;; The focused pane has a direct left sibling, but its right edge is
      ;; shared by the enclosing left subtree and the far-right pane.
      (should-not (eq (window-parent focused) (window-parent right)))
      (select-window focused)
      (should (numberp (dwindle-move-split-left)))
      (should (< (nth 0 (window-edges right)) (nth 0 right-before)))
      (should (= (nth 2 (window-edges right)) (nth 2 right-before)))
      (should (= (nth 2 (window-edges focused)) (nth 0 (window-edges right)))))))

(ert-deftest dwindle-resize-honors-the-focused-internal-node ()
  (dwindle-test--with-layout
    (let* ((left (selected-window))
           (top-right (dwindle-split))
           (bottom-right (dwindle-split))
           (left-width (window-total-width left))
           (right-width (window-total-width top-right)))
      (select-window bottom-right)
      (let ((node (dwindle-focus-parent))
            (before (dwindle-test--snapshot)))
        (should (eq node (window-parent bottom-right)))
        (should-not (window-live-p node))
        ;; Resizing the lower leaf alone could move the horizontal divider.
        ;; The focused whole right subtree has no movable vertical boundary.
        (should-not (dwindle-expand-up))
        (should-not (dwindle-shrink-down))
        (should (equal (dwindle-test--snapshot) before))
        (should (numberp (dwindle-expand-left)))
        (should (< (window-total-width left) left-width))
        (should (> (window-total-width top-right) right-width))
        (should (= (window-total-width top-right) (window-total-width bottom-right)))
        (should (eq (selected-window) bottom-right))
        (should (eq (dwindle--focused-node) node))))))

(ert-deftest dwindle-doom-wrapper-preserves-file-and-read-only-arguments ()
  (dwindle-test--with-layout
    (let (opened native-args)
      (cl-letf (((symbol-function 'evil-edit)
                 (lambda (file &optional _bang) (setq opened (list 'edit file))))
                ((symbol-function 'evil-view)
                 (lambda (file &optional _bang) (setq opened (list 'view file)))))
        (let* ((original (lambda (&rest args) (setq native-args args) 'native))
               (new (dwindle-doom--evil-split original nil "notes.org" nil)))
          (should (window-live-p new))
          (should (eq new (selected-window)))
          (should (equal opened '(edit "notes.org")))
          (should-not native-args)
          (dwindle-doom--evil-split original nil "read-only.org" t)
          (should (equal opened '(view "read-only.org")))
          (should (= (length (dwindle-test--windows)) 3))
          (should (eq (dwindle-doom--evil-split original 12 "sized.org" t)
                      'native))
          (should (equal native-args '(12 "sized.org" t)))
          (should (= (length (dwindle-test--windows)) 3))
          (set-window-parameter (selected-window) 'popup t)
          (should (eq (dwindle-doom--evil-split original nil "popup.org" nil)
                      'native))
          (should (equal native-args '(nil "popup.org" nil))))))))

(ert-deftest dwindle-doom-advice-wraps-doom-overrides-and-removes-only-itself ()
  (dwindle-test--with-layout
    (dwindle-mode -1)
    (cl-letf (((symbol-function 'evil-window-split) (lambda (&rest _) 'native))
              ((symbol-function 'evil-window-vsplit) (lambda (&rest _) 'native)))
      (let ((doom-override (lambda (&rest _) 'doom)))
        (unwind-protect
            (progn
              (dolist (command '(evil-window-split evil-window-vsplit))
                (advice-add command :override doom-override))
              (dwindle-mode 1)
              (should (window-live-p (funcall 'evil-window-split nil)))
              (should (window-live-p (funcall 'evil-window-vsplit nil)))
              (should (eq (funcall 'evil-window-split 10) 'doom))
              (should (= (length (dwindle-test--windows)) 3))
              (dwindle-mode -1)
              (dolist (command '(evil-window-split evil-window-vsplit))
                (should (advice-member-p doom-override command))
                (should (eq (funcall command nil) 'doom))))
          (dwindle-mode -1)
          (dolist (command '(evil-window-split evil-window-vsplit))
            (advice-remove command doom-override)))))))

