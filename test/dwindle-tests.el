(ert-deftest dwindle-rollback-suppresses-and-restores-buffer-local-and-global-hooks ()
  (dwindle-test--with-layout
    (let* ((a (generate-new-buffer " *dwindle-rollback-a*"))
           (b (generate-new-buffer " *dwindle-rollback-b*"))
           (source (selected-window))
           (root (dwindle-root-window))
           (calls 0)
           (global-hook (list (lambda () (cl-incf calls) (error "Hostile global hook"))))
           (local-hook (list (lambda () (cl-incf calls) (error "Hostile local hook"))))
           (previous-default (default-value 'buffer-list-update-hook))
           before view caught)
      (unwind-protect
          (progn
            (with-current-buffer a
              (dotimes (_ 30) (insert "A line long enough to scroll horizontally.\n")))
            (set-window-buffer source a)
            (set-window-point source 120)
            (set-window-start source 43 t)
            (set-window-hscroll source 3)
            (set-window-parameter source 'dwindle-test-marker 'keep)
            (setq before (dwindle-test--snapshot)
                  view (list (window-point source) (window-start source)
                             (window-hscroll source) (window-vscroll source)))
            (condition-case err
                (dwindle--call-with-window-transaction
                 (lambda ()
                   (set-window-buffer source b)
                   (split-window source nil 'right)
                   (set-window-parameter source 'popup 'poison)
                   (set-window-parameter source 'dwindle-test-marker 'damaged)
                   ;; Installing these after the mutation isolates rollback:
                   ;; restoring A runs its local hook in native Emacs.
                   (setq-default buffer-list-update-hook global-hook)
                   (with-current-buffer a
                     (setq-local buffer-list-update-hook local-hook))
                   (error "Original operation failure")))
              (error (setq caught err)))
            (should (equal caught '(error "Original operation failure")))
            (should (equal before (dwindle-test--snapshot)))
            (should (equal view (list (window-point source) (window-start source)
                                      (window-hscroll source) (window-vscroll source))))
            (should (eq source (selected-window)))
            (should (eq root (dwindle-root-window)))
            (should (eq (window-parameter source 'dwindle-test-marker) 'keep))
            (should-not (window-parameter source 'popup))
            (should (= calls 0))
            (should (eq (default-value 'buffer-list-update-hook) global-hook))
            (should (eq (buffer-local-value 'buffer-list-update-hook a) local-hook)))
        (setq-default buffer-list-update-hook previous-default)
        (with-current-buffer a (setq-local buffer-list-update-hook nil))
        (kill-buffer a)
        (kill-buffer b)))))

